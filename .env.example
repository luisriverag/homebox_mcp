# ---------------------------------------------------------------------------
# Homebox connection
# ---------------------------------------------------------------------------
# Base URL of your self-hosted Homebox instance (no trailing slash, no /api).
HOMEBOX_URL=http://homebox:7745

# Credentials used to log in to Homebox and obtain a bearer token.
# Create a dedicated Homebox user for this agent rather than reusing your own.
HOMEBOX_USERNAME=agent@example.com
HOMEBOX_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Safety switch
# ---------------------------------------------------------------------------
# Y = the agent can only read data (all create/update/delete tools are
#     disabled, in both the MCP server and the Telegram bot).
# N = full read & write access.
READONLY=Y

# ---------------------------------------------------------------------------
# Telegram "natural speaking agent"
# ---------------------------------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-bot-token

# Only this Telegram user ID is allowed to talk to the bot. Every other
# sender is ignored. Get your numeric ID from @userinfobot on Telegram.
ADMIN_TELEGRAMID=123456789

# ---------------------------------------------------------------------------
# Claude (powers the Telegram bot's natural-language understanding)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Process mode: mcp | telegram | both
# ---------------------------------------------------------------------------
MODE=both
